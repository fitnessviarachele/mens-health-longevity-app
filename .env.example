# Twilio SMS Setup Instructions
# 1. Get your credentials from https://console.twilio.com/
# 2. Run these commands in your terminal (replace with real values):

export TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
export TWILIO_AUTH_TOKEN=your_real_auth_token_here
export TWILIO_FROM=+1234567890

# 3. Then start the server:
npm run server

# Note: Environment variables are only set for the current terminal session
# For permanent setup, add them to your shell profile (~/.zshrc or ~/.bashrc)